{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM"],
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["site/**/*.js", "supabase/functions/**/*.js"]
}
